     use std::io::Cursor;
 
+    #[test]
+    fn element_unknown_size_accepts_every_vint_width() -> Result<()> {
+        for width in 1..=8 {
+            let mut data = vec![0x18, 0x53, 0x80, 0x67];
+            data.push(0xffu8 >> (width - 1));
+            data.extend(std::iter::repeat_n(0xff, width - 1));
